# ---------------------------------------------------------------------------
# Awaaz — environment variables
# ---------------------------------------------------------------------------
# 1) FRONTEND (public, bundled into the browser app). Copy to `.env.local` (dev) and set the same
#    names in Vercel → Project → Settings → Environment Variables. NEVER put server secrets here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_ANON_KEY=
# Google Maps JavaScript API browser key, HTTP-referrer restricted to your Vercel domain + localhost
VITE_GOOGLE_MAPS_API_KEY=
# Google Cloud Map ID (vector map) for Advanced Markers; "DEMO_MAP_ID" works for development
VITE_GOOGLE_MAP_ID=
# Firebase web app config (used ONLY for Cloud Messaging web push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# 2) SERVER SECRETS — Supabase Edge Function secrets ONLY (never in the frontend or the repo).
#    Put them in `supabase/functions/.env` (gitignored) and run:
#      supabase secrets set --env-file supabase/functions/.env
#    SUPABASE_URL / keys are injected into Edge Functions automatically.
# ---------------------------------------------------------------------------
# OpenAI — core AI provider (speech-to-text, extraction, vision, embeddings, verification, TTS, digests)
OPENAI_API_KEY=
# Google Gemini — fallback provider only (not wired yet)
GEMINI_API_KEY=
# Firebase service account JSON (whole file contents on one line) — FCM HTTP v1 push sending
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: server-side Google Geocoding key (API/IP restricted). Empty -> OpenStreetMap Nominatim fallback.
GOOGLE_GEOCODING_SERVER_KEY=
# Public URL of the deployed app (used for links inside push notifications)
APP_URL=https://<your-app>.vercel.app
